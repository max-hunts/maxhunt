---
// PostHog analytics. Loads only when a key is configured in src/consts.ts.
//
// SPA gotcha: the site uses <ClientRouter /> (view transitions), so navigations
// don't full-reload and PostHog's automatic pageview would fire only once. We
// disable auto pageviews and capture one manually on `astro:page-load`, which
// Astro fires on the initial load AND after every client-side navigation.
//
// Autocapture (on by default) records clicks/inputs/etc. without per-element
// wiring → "interaction levels" for free. Geo (country/region/city) + IP are
// enriched server-side by PostHog on ingest; known bots are filtered there.
import { ANALYTICS } from '../consts';
const { key, host, uiHost } = ANALYTICS;
---

{
  key && (
    <>
      <link rel="preconnect" href={host} crossorigin />
      <script is:inline define:vars={{ key, host, uiHost }}>
        !(function (t, e) {
          var o, n, p, r;
          e.__SV ||
            ((window.posthog = e),
            (e._i = []),
            (e.init = function (i, s, a) {
              function g(t, e) {
                var o = e.split('.');
                2 == o.length && ((t = t[o[0]]), (e = o[1])),
                  (t[e] = function () {
                    t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
                  });
              }
              ((p = t.createElement('script')).type = 'text/javascript'),
                (p.crossOrigin = 'anonymous'),
                (p.async = !0),
                (p.src =
                  s.api_host.replace('.i.posthog.com', '-assets.i.posthog.com') +
                  '/static/array.js'),
                (r = t.getElementsByTagName('script')[0]).parentNode.insertBefore(p, r);
              var u = e;
              for (
                void 0 !== a ? (u = e[a] = []) : (a = 'posthog'),
                  u.people = u.people || [],
                  u.toString = function (t) {
                    var e = 'posthog';
                    return 'posthog' !== a && (e += '.' + a), t || (e += ' (stub)'), e;
                  },
                  u.people.toString = function () {
                    return u.toString(1) + '.people (stub)';
                  },
                  o =
                    'init me ws ys ps bs capture je Di ks register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey canRenderSurveyAsync identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty Ne xs createPersonProfile Es opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing Ss debug ye getPageViewId captureTraceFeedback captureTraceMetric'.split(
                      ' ',
                    ),
                  n = 0;
                n < o.length;
                n++
              )
                g(u, o[n]);
              e._i.push([i, s, a]);
            }),
            (e.__SV = 1));
        })(document, window.posthog || []);

        // Internal traffic: a browser counts as the owner's when it has the
        // mh_internal=1 cookie, which Board (board.maxhunt.dev) sets on the
        // parent domain at sign-in, or when it was flagged by visiting any page
        // with ?internal=1 (?internal=0 clears both the flag and the cookie in
        // this browser). Internal browsers aren't session-recorded and their
        // person gets $internal_or_test_user=true, which the PostHog project's
        // "Internal / Test users" cohort (the test-account filter) excludes.
        var internal = false;
        try {
          var q = new URLSearchParams(location.search).get('internal');
          if (q === '1') localStorage.setItem('mh_internal', '1');
          if (q === '0') {
            localStorage.removeItem('mh_internal');
            document.cookie = 'mh_internal=; Max-Age=0; Path=/; Domain=' + location.hostname;
          }
          internal =
            localStorage.getItem('mh_internal') === '1' ||
            /(?:^|;\s*)mh_internal=1(?:;|$)/.test(document.cookie);
        } catch (e) {}

        window.posthog.init(key, {
          api_host: host, // first-party Cloudflare proxy (see src/consts.ts)
          ui_host: uiHost, // PostHog's own UI origin (toolbar/links resolve here)
          capture_pageview: false, // we fire $pageview manually (see below)
          capture_pageleave: true, // tab-close / unload leaves
          capture_performance: { web_vitals: true }, // Core Web Vitals (LCP/INP/CLS)
          // Session replay is on (project settings mask all inputs); the
          // recorder loads asynchronously after init. Flagged internal browsers
          // skip it. Surveys stay off (surveys.js not loaded).
          disable_session_recording: internal,
          disable_surveys: true,
          persistence: 'localStorage+cookie',
          loaded: function (ph) {
            if (internal) ph.setPersonProperties({ $internal_or_test_user: true });
          },
        });

        // Initial load + every ClientRouter navigation.
        document.addEventListener('astro:page-load', function () {
          if (window.posthog) window.posthog.capture('$pageview');
        });
        // ClientRouter navigations don't unload the page, so the automatic
        // $pageleave never fires between routes → bounce rate / time-on-page
        // would be wrong. Fire it manually right before each swap.
        document.addEventListener('astro:before-swap', function () {
          if (window.posthog) window.posthog.capture('$pageleave');
        });
      </script>
    </>
  )
}
