{
  "name": "gg-marketplace-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Client-side GG Marketplace demo: the 2020 Express + Firebase API ported to an in-browser backend, with a new UI. Builds into ../../public/gg-demo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
