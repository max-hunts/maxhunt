{
  "name": "polypaint-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Client-side PolyPaint demo: the real Pixels.sol bytecode in an in-browser EVM behind a simulated wallet. Builds into ../../public/polypaint-demo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "gen:abi": "node scripts/gen-abi.mjs"
  },
  "dependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.19",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
